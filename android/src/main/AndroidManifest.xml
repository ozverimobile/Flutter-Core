<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.flutter.flutter_core">

    <!-- CoreCloudNotification -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="com.flutter.flutter_core.cloudnotification.CoreCloudNotificationMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Sunucu android.channelId / android.smallIcon göndermezse sistemin göstereceği bildirimler için. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="genel" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_core_notification" />
        <!-- Push kullanmayan uygulamalarda açılışta FCM token üretilmesin; CoreCloudNotification.initialize token'ı kendisi ister. -->
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />
    </application>
</manifest>
